# Port exposé sur l'hôte (le conteneur écoute toujours sur 5000)
PORT=__PORT__
# 127.0.0.1 = accessible uniquement via le reverse proxy ; 0.0.0.0 pour ouvrir
BIND_IP=127.0.0.1
# Préfixe d'URL de ce service derrière le reverse proxy
URL_PREFIX=/__SLUG__
# Auth vu depuis le navigateur de l'utilisateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique de ce service, sans slash final (retour après déconnexion)
PUBLIC_URL=https://mon-domaine.fr/__SLUG__
# Auth vu depuis le conteneur (réseau Docker "web"), si auth_client en a besoin
AUTH_INTERNAL_URL=http://auth:25000/auth
